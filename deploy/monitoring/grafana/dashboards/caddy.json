      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(caddy_http_request_duration_seconds_count{job=\"caddy\",server=\"estymathon_https\",handler=\"subroute\",code=~\"5..\"}[1m])) or (0 * (sum(rate(caddy_http_request_duration_seconds_count{job=\"caddy\",server=\"estymathon_https\",handler=\"subroute\",code!=\"101\"}[1m]))))",
          "legendFormat": "HTTP 5xx / sec",
          "datasource": {
            "type": "prometheus",
