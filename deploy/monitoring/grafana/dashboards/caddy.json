{
  "uid": "estymathon-caddy",
  "title": "Estymathon \u00b7 Caddy",
  "description": "Five-second monitoring of the HTTPS proxy and Socket.IO transports. Latency percentiles are rolling one-minute histogram estimates.",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "tags": ["estymathon", "caddy"],
  "timezone": "browser",
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "HTTP p95",
      "description": "Estimated from Caddy histogram buckets. Includes Socket.IO polling; excludes WebSocket lifetimes (HTTP 101).",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "min": 0,
          "noValue": "No samples"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "1000 * histogram_quantile(0.95, sum by (le) (rate(caddy_http_request_duration_seconds_bucket{job=\"caddy\",server=\"estymathon_https\",handler=\"subroute\",code!=\"101\"}[1m])))",
          "legendFormat": "HTTP p95 (last minute)",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 2,
      "title": "Requests / sec",
      "description": "",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "noValue": "No samples"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(caddy_http_request_duration_seconds_count{job=\"caddy\",server=\"estymathon_https\",handler=\"subroute\",code!=\"101\"}[1m]))",
          "legendFormat": "Completed HTTP requests / sec",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 3,
      "title": "Socket.IO clients",
      "description": "Live transport connections, including anonymous projectors. Not unique people or idle HTTP keep-alive sockets.",
