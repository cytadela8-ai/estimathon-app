      "targets": [
        {
          "refId": "A",
          "expr": "sum(estymathon_socketio_connections{job=\"estymathon\"})",
          "legendFormat": "Socket.IO connections",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true,
          "range": false
        }
      ]
    },
    {
