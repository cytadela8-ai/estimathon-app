# Operator-provided PEM certificate and key; certificate automation and OCSP fetching are disabled.
{
	auto_https off
	ocsp_stapling off
	servers :80 {
		protocols h1
	}
}

http://{$DOMAIN} {
	redir https://{$DOMAIN}{uri} 308
}

https://{$DOMAIN} {
	tls /etc/caddy/certs/fullchain.pem /etc/caddy/certs/privkey.pem
	encode zstd gzip
	header Strict-Transport-Security "max-age=31536000"
	reverse_proxy app:3000
}
