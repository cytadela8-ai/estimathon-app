{
  "name": "estymathon",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "imports": {
    "#est-server/*": {
      "development": "./src/server/*.ts",
      "types": "./src/server/*.ts",
      "default": "./dist/server/*.js"
    },
    "#est-shared/*": {
      "development": "./src/shared/*.ts",
      "types": "./src/shared/*.ts",
      "default": "./dist/shared/*.js"
    },
    "#est-client/*": {
      "development": "./src/client/*.ts",
      "types": "./src/client/*.ts",
      "default": "./dist/client/*.js"
    },
    "#est-e2e/*": {
      "types": "./tests/e2e/*.ts",
      "default": "./tests/e2e/*.ts"
    }
  },
  "scripts": {
    "dev": "tsx watch --conditions=development --env-file-if-exists=.env src/server/index.ts",
    "dev:client": "vite --host 0.0.0.0",
    "build": "vite build && tsc -p tsconfig.server.json",
    "start": "node --env-file-if-exists=.env dist/server/index.js",
    "check": "svelte-check --tsconfig ./tsconfig.json && tsc --noEmit",
    "lint": "oxlint --deny-warnings && oxfmt --check .",
    "format": "oxfmt .",
    "test": "NODE_OPTIONS=--conditions=development vitest run",
    "test:e2e": "pnpm build && NODE_ENV=test playwright test"
  },
  "dependencies": {
    "@fastify/static": "10.1.8",
    "better-sqlite3": "13.0.3",
    "fastify": "5.12.7",
    "qrcode": "1.5.4",
    "socket.io": "4.8.4",
    "socket.io-client": "4.8.4",
    "svelte": "5.57.3"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "22.20.0",
    "@types/qrcode": "1.5.6",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "svelte-check": "4.7.7",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "packageManager": "pnpm@10.34.7"
}
