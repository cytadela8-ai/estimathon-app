{
  "plugins": ["typescript", "import", "unicorn"],
  "categories": {
    "correctness": "error"
  },
  "ignorePatterns": ["dist/**", "node_modules/**"],
  "rules": {
    "complexity": ["error", 8],
    "max-lines-per-function": [
      "error",
      {
        "max": 100,
        "skipBlankLines": true,
        "skipComments": true
      }
    ]
  }
}
