# Copy to .env.production and set a unique password of at least 16 characters.
# Leave no spaces around '='. Single-quote passwords containing '$' or '#'.
ADMIN_PASSWORD=

# HTTP setup only: the host port; the container always listens on 3000.
HTTP_PORT=80

# HTTPS setup: accepts any hostname or IP address pointing at this server.
# Absolute paths to existing PEM files, readable by Caddy's UID/GID 1000:1000.
# The chain contains the server certificate followed by intermediate certificates.
TLS_CERT_PATH=/absolute/path/to/fullchain.pem
TLS_KEY_PATH=/absolute/path/to/privkey.pem

# Optional monitoring overlay: choose a dedicated password before the first Grafana startup.
GRAFANA_ADMIN_PASSWORD=
